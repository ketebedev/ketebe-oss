{
  "name": "@ketebe/client",
  "version": "0.1.0",
  "description": "First-party TypeScript client for Ketebe",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "README.md"],
  "engines": {"node": ">=20"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/contract.test.js",
    "test:integration": "npm run build && node --test dist/test/real-server.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "json-bigint": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0"
}
